{
	"name": "toolbox-x-docs",
	"version": "1.2.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm --filter toolbox-x build && pnpm changelog && pnpm gen && next build",
		"dev": "pnpm changelog && pnpm gen && next dev",
		"start": "next start",
		"changelog": "node scripts/update-changelog.mjs",
		"gen": "node scripts/generate-types.mjs",
		"typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
		"typegen": "next typegen",
		"postinstall": "fumadocs-mdx",
		"validate:links": "fumadocs-mdx && bun scripts/validate-links.ts",
		"fix": "biome check --write --diagnostic-level=error",
		"lint": "biome check --diagnostic-level=error",
		"format": "biome format --write --diagnostic-level=error"
	},
	"dependencies": {
		"@ai-sdk/react": "^4.0.186",
		"@monaco-editor/react": "^4.7.0",
		"@openrouter/ai-sdk-provider": "^3.1.0",
		"@radix-ui/react-accordion": "^1.3.1",
		"@radix-ui/react-collapsible": "^1.2.1",
		"@radix-ui/react-popover": "^1.3.1",
		"@radix-ui/react-presence": "^1.1.11",
		"@radix-ui/react-scroll-area": "^1.4.0",
		"@radix-ui/react-tabs": "^1.2.1",
		"ai": "^7.0.181",
		"class-variance-authority": "^0.7.1",
		"flexsearch": "^0.8.212",
		"fumadocs-core": "16.19.7",
		"fumadocs-mdx": "15.6.4",
		"fumadocs-twoslash": "^4.0.5",
		"fumadocs-ui": "16.19.7",
		"hast-util-to-jsx-runtime": "^2.3.7",
		"lucide-react": "^1.80.0",
		"next": "16.4.6",
		"next-themes": "^0.4.6",
		"next-validate-link": "^1.6.7",
		"nhb-hooks": "^1.51.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-hot-toast": "^2.6.1",
		"react-icons": "^5.7.0",
		"remark": "^15.0.1",
		"remark-gfm": "^4.0.1",
		"remark-rehype": "^11.1.2",
		"scroll-into-view-if-needed": "^3.2.1",
		"sucrase": "^3.35.1",
		"tailwind-merge": "^3.7.1",
		"toolbox-x": "workspace:*",
		"twoslash": "^0.3.9",
		"unist-util-visit": "^5.2.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.9",
		"@tailwindcss/postcss": "^4.3.5",
		"@types/hast": "^3.0.5",
		"@types/mdx": "^2.0.14",
		"@types/node": "^26.6.10",
		"@types/react": "^19.3.3",
		"@types/react-dom": "^19.3.0",
		"bun": "^1.4.5",
		"csstype": "^3.2.4",
		"github-slugger": "^2.0.0",
		"postcss": "^8.5.33",
		"tailwindcss": "^4.3.5",
		"type-fest": "^6.0.3",
		"typescript": "^7.0.2"
	}
}
